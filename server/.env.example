PORT=5000
DB_URL=mongodb://127.0.0.1:27017/yourtube
# Render persistent disk mount path; keep the default local uploads path for development.
UPLOAD_DIR=./uploads
FIREBASE_PROJECT_ID=your-firebase-project-id
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
MEDIA_TOKEN_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
RESEND_API_KEY=
SECURITY_EMAIL_FROM=YourTube Security <security@your-verified-domain.com>
SUPPORT_EMAIL=support@your-verified-domain.com
# Twilio Verify is optional; required to enroll a mobile number or deliver SMS sign-in codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
COMMENT_BLOCKED_TERMS=
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
MODERATOR_EMAILS=moderator@example.com
TURNSTILE_SECRET_KEY=
# Optional local GeoLite2 City database; keep the .mmdb file out of source control.
GEOIP_DB_PATH=./GeoLite2-City.mmdb
# JaaS credentials; encode private-key newlines as \n in hosted environment variables
JITSI_APP_ID=
JITSI_API_KEY_ID=
JITSI_PRIVATE_KEY=
